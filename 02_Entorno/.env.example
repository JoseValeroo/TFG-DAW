# ============================================
# Configuración de Docker para Desarrollo
# ============================================
#
# INSTRUCCIONES:
#   1. Copiar este archivo a .env
#   2. Modificar los valores según necesidad
#   3. NUNCA commitear .env con credenciales reales
#
# ============================================

# Nombre del proyecto (usado para nombrar contenedores)
PROJECT_NAME=miproyecto

# ============================================
# SQL Server 2017
# ============================================
# Contraseña del usuario SA (mínimo 8 caracteres, con mayúsculas, minúsculas, números)
SA_PASSWORD=DevPassword123!

# Puerto externo (cambiar si hay conflicto)
SQL_PORT=1433

# Límite de memoria en MB
SQL_MEMORY_LIMIT=2048

# ============================================
# Redis
# ============================================
REDIS_PORT=6379

# ============================================
# Azurite (Emulador Azure Storage)
# ============================================
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002

# ============================================
# Mailhog (SMTP de pruebas)
# ============================================
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
