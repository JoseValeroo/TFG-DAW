# Copia este archivo a .env y rellena tus valores locales.
PORT=3000
FRONTEND_URL=http://localhost:5173

# MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lure
# En desarrollo TypeORM crea/actualiza las tablas solo. NUNCA usar true en producción.
DB_SYNCHRONIZE=true

# JWT — genera un secreto largo y aleatorio para tu entorno
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES=7d
